# Managed by deploy/ansible/start.yml; edits are overwritten.
[Unit]
Description=care-bot API
After=network-online.target

[Service]
WorkingDirectory={{ repo_dir }}
EnvironmentFile={{ config_dir }}/env
ExecStart={{ venv }}/bin/uvicorn care.api:create_app --factory --host {{ api_host }} --port {{ api_port }} --workers {{ api_workers }}
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
